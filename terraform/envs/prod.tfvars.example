# Copy to prod.tfvars. *.tfvars is gitignored; only the .example files are committed.
#
# Used as: terraform apply -var-file=../../envs/prod.tfvars
#
# Do not leave prod running to demo it. Use dev, and destroy it afterwards.

project = "slipway"
region  = "us-east-1"

ecr_repository_name = "slipway-app"

memory_size = 1024
timeout     = 30

# Longer than dev: when something breaks in prod you want the logs to still be there.
log_retention_days = 30

# Always on in prod: static files from the edge, one hostname for page and API, and no
# Lambda invocation for a file that never changes.
enable_cdn      = true
cdn_price_class = "PriceClass_100"

# In prod the alarms have to reach a person. SNS email subscriptions need confirming
# from the inbox before they deliver anything.
enable_observability = true
alert_emails         = ["you@example.com"]
