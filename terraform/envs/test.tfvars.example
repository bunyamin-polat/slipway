# Copy to test.tfvars. *.tfvars is gitignored; only the .example files are committed.
#
#   cp test.tfvars.example test.tfvars
#
# This environment exists to run the *other* compute target, so the two can be measured
# side by side rather than argued about. Bring it up, take the numbers, destroy it.
#
# It costs money while it exists: App Runner keeps at least one instance provisioned and
# bills for its memory around the clock. Roughly $3-5/month at this size — which is why
# `destroy.py test` is part of the exercise, not an afterthought.

project = "slipway"
region  = "us-east-1"

ecr_repository_name = "slipway-app"

compute_target   = "apprunner"
apprunner_cpu    = "0.25 vCPU"
apprunner_memory = "0.5 GB"

timeout = 30

# No CDN and no dashboard: this environment exists for one measurement, and the App
# Runner metrics live in a different namespace than the dashboard is built for.
enable_cdn           = false
enable_observability = false
