# Copy to dev.tfvars. *.tfvars is gitignored; only the .example files are committed.
#
#   cp dev.tfvars.example dev.tfvars
#
# Used as: terraform apply -var-file=../../envs/dev.tfvars

project = "slipway"
region  = "us-east-1"

ecr_repository_name = "slipway-app"

# Cheap and disposable. dev exists to be destroyed and rebuilt.
memory_size        = 1024
timeout            = 30
log_retention_days = 7

# Off for the fast loop: 22-second teardowns instead of 15-minute ones. An idle
# distribution is free, so this is about time, not money. Flip it to true when the CDN
# path is what you are testing.
enable_cdn = false

# Alarms and a dashboard. Free at this size: three alarms fit inside the free tier's ten,
# and the first three dashboards per account cost nothing.
enable_observability = true

# Leave empty in dev and the alarms still fire, they just reach nobody. Fill it in prod.
alert_emails = []
