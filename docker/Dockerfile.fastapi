# Python-only backend: FastAPI served by uvicorn, wrapped by the AWS Lambda Web Adapter
# so the same image runs unchanged locally and on Lambda.
#
# Build context is `template/`:
#   docker build --platform linux/amd64 -f docker/Dockerfile.fastapi -t slipway-app template/
#
# Use Dockerfile.fullstack instead when the frontend needs a real build step.

FROM public.ecr.aws/docker/library/python:3.12-slim

# The adapter is a Lambda extension: it translates Lambda invocations into ordinary
# HTTP requests against 127.0.0.1:$PORT, which is why the app below is a plain uvicorn
# server with no Lambda-specific code in it. On a local `docker run` the extension is
# simply never started, so the same image serves HTTP directly.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter

ENV PORT=8080

# Without this the adapter buffers the whole response and SSE silently stops working:
# the client gets the entire answer in one lump at the end. The response still looks
# correct, which is what makes it so easy to ship broken. This one line is the
# difference between a streaming UI and a broken one.
ENV AWS_LWA_INVOKE_MODE=response_stream

# The adapter waits for this path to answer before it reports the container ready.
ENV AWS_LWA_READINESS_CHECK_PATH=/healthz

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Dependencies first: this layer is cached and only rebuilt when requirements change,
# which is what keeps an application-code deploy down to seconds.
#
# uv rather than pip, because this image is built for linux/amd64 under emulation on an
# ARM Mac and pip's resolve-and-install is the slowest part of that. The binary is
# copied in and deleted inside the same layer, so it costs nothing in the final image —
# and image size is not free here, it shows up in Lambda cold starts.
COPY --from=ghcr.io/astral-sh/uv:0.11.30 /uv /bin/uv
COPY app/requirements.txt ./
RUN uv pip install --system --no-cache -r requirements.txt && rm /bin/uv

COPY app/ ./

EXPOSE 8080

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080"]
